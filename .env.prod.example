# Copie para .env no mesmo diretório do compose (chmod 600 .env).
# O Compose lê este arquivo automaticamente — não versionar o .env.

POSTGRES_DB=vida_conecta
POSTGRES_USER=vida_conecta
POSTGRES_PASSWORD=

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   ← cole só o Base64, sem aspas e sem < >
EHR_ENCRYPTION_KEY=
JWT_EXPIRATION_MINUTES=30

CORS_ALLOWED_ORIGINS=https://vida-conecta-frontend.vercel.app,https://*.vercel.app
FRONTEND_BASE_URL=https://vida-conecta-frontend.vercel.app
SES_ENABLED=true
MAIL_FROM=no-reply@darcaltech.com.br
AWS_REGION=us-east-1

# Só se a EC2 não tiver IAM role com ses:SendEmail
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

API_DOMAIN=api.seudominio.com
# LETSENCRYPT_DIR=/etc/letsencrypt
BACKEND_IMAGE=ppedro3421/vida-conecta-backend:latest

# Grafana (porta 3000). Restrinja o Security Group ao seu IP.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
